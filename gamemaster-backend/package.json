{
  "name": "gamemaster-backend",
  "version": "1.0.0",
  "description": "Serveur backend GameMaster pour l'application L5R - Gestion des rooms et parties multijoueurs",
  "main": "src/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck",
    "security-audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "gamemaster",
    "l5r",
    "legend-of-five-rings",
    "rpg",
    "websockets",
    "rooms",
    "multiplayer"
  ],
  "author": "GameMaster Team",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ajv": "^8.17.1",
    "reflect-metadata": "^0.1.14",
    "pg": "^8.11.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "xss-clean": "^0.1.4",
    "typeorm": "^0.3.19",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.5",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "@types/bcrypt": "^5.0.0",
    "@types/hpp": "^0.2.1",
    "typescript": "^5.9.2",
    "tsx": "^4.20.6",
    "@types/node": "^22.15.0",
    "@types/cors": "^2.8.17"
  }
}
