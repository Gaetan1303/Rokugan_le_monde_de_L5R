NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamemaster
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:4200,https://gaetan1303.github.io
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
WS_MAX_CONNECTIONS_PER_IP=10
WS_HEARTBEAT_INTERVAL=30000
WS_TIMEOUT=60000
MAX_REQUEST_SIZE=10kb
HELMET_ENABLED=true

# --- Temps réel Mercure (désactivé si MERCURE_URL est absent) ---
# Voir docs/REALTIME.md. Avec `docker compose up -d` à la racine du dépôt :
MERCURE_URL=http://localhost:3901/.well-known/mercure
# URL du hub vue par le NAVIGATEUR (défaut : MERCURE_URL)
# MERCURE_PUBLIC_URL=
MERCURE_PUBLISHER_JWT_KEY=dev-publisher-key-change-me-0123456789abcdef
MERCURE_SUBSCRIBER_JWT_KEY=dev-subscriber-key-change-me-0123456789abcdef
# 1 = hub Mercure 1.x (défaut) ; legacy = hub 0.x
MERCURE_PROTOCOL=1
# Égal à MERCURE_TRUSTED_ISSUERS du hub. OBLIGATOIRE en production (protocole 1).
MERCURE_ISSUER=https://localhost
# MERCURE_AUDIENCE=
# cookie (front et hub sur le même domaine) ou bearer (hub sur un autre domaine)
MERCURE_AUTH_MODE=cookie
# MERCURE_COOKIE_NAME=
# MERCURE_COOKIE_DOMAIN=
MERCURE_COOKIE_SAMESITE=strict
# MERCURE_COOKIE_SECURE=
MERCURE_SUBSCRIBER_TTL_SECONDS=900
DEFAULT_REALM_ID=default
